{
  "name": "den-desktop",
  "private": true,
  "version": "0.1.5",
  "description": "Den Desktop — multi-agent operator UI for Den Channels and Den server",
  "author": "Patch (https://github.com/FuzzySlipper)",
  "type": "module",
  "main": "electron-dist/main.mjs",
  "scripts": {
    "ui:dev": "vite --host 127.0.0.1 --port 1421",
    "ui:build": "tsc --noEmit && vite build",
    "electron:build": "esbuild src/electron/main.ts --bundle --platform=node --format=esm --outfile=electron-dist/main.mjs --external:electron --external:ws && esbuild src/electron/preload.ts --bundle --platform=node --format=cjs --outfile=electron-dist/preload.cjs --external:electron",
    "electron:dev": "npm run ui:build && npm run electron:build && npx electron electron-dist/main.mjs",
    "electron:dev:hot": "npm run electron:build && node electron-launch-hot.mjs",
    "test:helpers": "node --test tests/*.test.mjs",
    "sidecar:dev": "dotnet run --project ../DenMcp.Desktop.Sidecar --",
    "sidecar:publish": "rm -rf dist-resources/sidecar && dotnet publish ../DenMcp.Desktop.Sidecar --configuration Release --runtime linux-x64 --self-contained true -p:PublishSingleFile=true -p:DebugType=embedded --output dist-resources/sidecar",
    "dist:linux": "npm run ui:build && npm run electron:build && npm run sidecar:publish && npx electron-builder --linux AppImage"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.den.desktop",
    "productName": "Den Desktop",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../build-assets/icon.png",
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "dist-resources/",
        "to": "den-desktop-resources/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../testdata/",
        "to": "testdata/",
        "filter": [
          "den-desktop-sidecar/**"
        ]
      }
    ],
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "electron-launch-hot.mjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "../../build-assets"
    }
  }
}
